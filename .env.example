# ─── Database ────────────────────────────────────────────────────────────────
# Supabase *transaction pooler* connection string (port 6543).
# Supabase dashboard → Connect → "Transaction pooler", or copy POSTGRES_URL that
# the Vercel ↔ Supabase integration creates. Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ─── Access ──────────────────────────────────────────────────────────────────
# The password you type on the login page. Use something long.
APP_PASSWORD=change-me-to-a-long-passphrase
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs you out everywhere.
SESSION_SECRET=replace-with-at-least-32-random-characters

# ─── Groq (voice assistant) ──────────────────────────────────────────────────
# Free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Model IDs change over time — see https://console.groq.com/docs/models
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# ─── Keep-alive (Vercel Cron) ────────────────────────────────────────────────
# Random string; Vercel sends it to /api/cron/keepalive once a day so the free
# Supabase project isn't paused for inactivity. Generate like SESSION_SECRET.
CRON_SECRET=replace-with-a-random-string
